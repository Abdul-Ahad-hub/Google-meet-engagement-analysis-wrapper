# Postgres (Neon pooled connection string for storing Google Meet session ownership & metadata)
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Core Engagement Analysis Engine base URL (domain-agnostic engine microservice)
ENGAGEMENT_ENGINE_URL="https://engagement-analysis-system.vercel.app"
ENGAGEMENT_ENGINE_TIMEOUT_MS=35000

# Server settings (local development)
PORT=3001
NODE_ENV=production
BODY_LIMIT=10mb
